{
  "name": "sortir-be-v18-vercel",
  "private": true,
  "version": "18.4.2-refresh-no-regression",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "qa": "python qa/run_qa.py",
    "build": "node scripts/build-vercel.mjs",
    "vercel:preview": "vercel deploy",
    "vercel:prod": "vercel deploy --prod",
    "qa:filter-scroll": "python qa/filter-scroll-regression.py",
    "collect": "node scripts/collect-events.mjs --mode=fast",
    "collect:deep": "node scripts/collect-events.mjs --mode=deep",
    "collect:all": "node scripts/collect-events.mjs --mode=all",
    "validate:data": "node scripts/validate-snapshot.mjs",
    "sources:recover": "node tools/extract-source-config.mjs"
  }
}
