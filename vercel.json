{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 300,
      "includeFiles": "**/*"
    },
    "api/events.js": {
      "maxDuration": 300,
      "includeFiles": "**/*"
    },
    "api/event-photos.js": {
      "maxDuration": 15
    },
    "api/picture.js": {
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "fluid": true
}
